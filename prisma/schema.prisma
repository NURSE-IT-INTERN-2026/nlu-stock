generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// Dispense behavior of a CategoryProfile (ประเภท). The only fixed enum.
// CONSUMABLE = ใช้แล้วทิ้ง (lot tracking, นับ remaining)
// COUNT      = ยืม-คืน นับจำนวน (track how many out)
// ITEM       = ยืม-คืน รายชิ้น (subItems, builder code)
enum DispenseType {
  CONSUMABLE
  COUNT
  ITEM
}

enum ItemStatus {
  AVAILABLE
  ON_LOAN
  IN_USE
  DAMAGED
  UNDER_REPAIR
  LOST
  PENDING_MAINTENANCE
  DISPOSED
}

enum Role {
  ADMIN
  STAFF
  INSTRUCTOR
  CHILDREN
}

enum AdjustmentReason {
  LOST
  DAMAGED_PENDING_REPAIR
  COUNT_MISMATCH_SHORT
  COUNT_MISMATCH_OVER
  DISPOSAL
  ASSEMBLY
  OTHER
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
}

enum MaintenanceResult {
  AVAILABLE
  NEEDS_MORE_REPAIR
  DISPOSED
}

// Where a damaged piece is sent for repair (set on the DAMAGED → UNDER_REPAIR log row).
enum RepairVenue {
  INTERNAL
  EXTERNAL
}

enum ItemCondition {
  NEW
  OLD
  USABLE
  FAIR
  UNUSABLE
  DAMAGED
}

// Outcome recorded when a borrowable loan is returned. AVAILABLE = ปกติ.
enum ReturnCondition {
  AVAILABLE
  DAMAGED
  LOST
}

// How a durable was issued. BORROW = ยืม (must return by dueAt); INUSE = ตั้งใช้ในห้อง
// (open-ended, no due date, returned via คืนเข้าพัสดุ / status route, NOT the รับคืน loan screen).
enum LoanType {
  BORROW
  INUSE
}

enum UsageType {
  COURSE
  ACTIVITY
  OTHER
}

// --- Users ---
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(STAFF)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dispenseRecords    DispenseRecord[]
  receiveRecords     ReceiveRecord[]
  adjustments        StockAdjustment[]
  maintenanceRecords MaintenanceRecord[]
  statusChanges      ItemStatusLog[]
  locationChanges    LocationChangeLog[]

  @@map("users")
}

// --- Categories ---
model CategoryType {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  sortOrder   Int     @default(0)

  // ประเภท (profile) — กำหนด dispense/track behavior
  profileId String
  profile   CategoryProfile @relation(fields: [profileId], references: [id])

  items Item[]

  @@map("categories")
}

// ประเภท (CategoryProfile) — addable from UI. behavior อยู่ใน dispenseType + flags.
// icon/color/name/desc = cosmetic. code = prefix สำหรับ NLU-{code}-NNN.
model CategoryProfile {
  id            String       @id @default(cuid())
  name          String       @unique
  code          String       @unique
  description   String?
  dispenseType  DispenseType
  assetTracking Boolean      @default(false) // โชว์ fields จัดซื้อ/บำรุงรักษา (KRU/ELE)
  setTracking   Boolean      @default(false) // โชว์ setSize/borrowable (BOOK/TOY)
  icon          String       @default("Package")
  color         String       @default("bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200")
  sortOrder     Int          @default(0)
  isActive      Boolean      @default(true)

  subCategories CategoryType[]

  @@map("category_profiles")
}

// --- Locations ---
model Location {
  id       String  @id @default(cuid())
  building String
  floor    String
  room     String
  detail   String?

  items Item[]
  subItems SubItem[]

  @@unique([building, floor, room, detail])
  @@map("locations")
}

// --- Units ---
model Unit {
  id   String @id @default(cuid())
  name String @unique

  items      Item[]  @relation("UnitItem")
  kitBomItems KitBom[]

  @@map("units")
}

// --- Items ---
model Item {
  id                String       @id @default(cuid())
  code              String       @unique
  name              String
  nameEn            String?
  categoryId        String
  category          CategoryType @relation(fields: [categoryId], references: [id])
  trackIndividually Boolean      @default(false)
  status            ItemStatus   @default(AVAILABLE)
  issueUnitId       String
  issueUnit         Unit         @relation("UnitItem", fields: [issueUnitId], references: [id])
  minThreshold      Int          @default(0)
  locationId        String?
  location          Location?    @relation(fields: [locationId], references: [id])
  imageUrl          String?
  images            String[]     @default([])
  description       String?
  isActive          Boolean      @default(true)

  // AI embedding (pgvector)
  embedding Unsupported("vector(768)")?
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt

  // Running total
  totalQty     Int @default(0)
  availableQty Int @default(0)

  // Consumable fields (used when category = CON)
  storageRequirements String?

  // Book/Toy set + borrowing (see ADR-0001)
  setSize    Int     @default(1) // volumes per set; 1 = single
  // How many may be out on loan at once. 0 = ห้ามยืม. borrowable is derived from
  // it on write (borrowLimit > 0) — edit borrowLimit, never borrowable.
  borrowLimit Int     @default(0)
  borrowable  Boolean @default(false)

  // Stock count cycle (ตรวจนับ). countCycleMonths null = use the profile default
  // (CONSUMABLE 3 months, everything else 12) — see src/lib/stock-count.ts. Set a
  // number to override per item. nextCountDate null = never counted → due now.
  countCycleMonths Int?
  lastCountDate    DateTime?
  nextCountDate    DateTime?

  // Fixed Asset fields (nullable, used when category = KRU, ELE)
  model                  String?
  purchaseDate           DateTime?
  purchasePrice          Float?
  vendorCompany          String?
  vendorContact          String?
  vendorPhone            String?
  warrantyMonths         Int       @default(0)
  maintenanceCycleMonths Int       @default(12)
  lastMaintenanceDate    DateTime?
  nextMaintenanceDate    DateTime?
  manualUrl              String?

  // Relations
  subItems           SubItem[]
  lots               Lot[]
  kitComponents      KitBom[] @relation("KitBomItems") // KIT "ภายในชุดประกอบด้วย" (BOM)
  componentsInKits   KitBom[] @relation("KitComponents") // reverse: ถูกใช้เป็นส่วนประกอบในชุดอื่น
  dispenseRecords    DispenseRecord[]
  receiveRecords     ReceiveRecord[]
  adjustments        StockAdjustment[]
  maintenanceRecords MaintenanceRecord[]
  statusLogs         ItemStatusLog[]
  locationChanges    LocationChangeLog[]

  @@index([categoryId, isActive])
  @@index([locationId])
  @@index([availableQty])
  @@map("items")
}

// --- Sub-Items ---
model SubItem {
  id           String         @id @default(cuid())
  itemId       String
  item         Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  subCode      String
  name         String?
  status       ItemStatus     @default(AVAILABLE)
  condition    ItemCondition?
  serialNumber String?
  notes        String?
  imageUrl     String?
  images       String[]
  locationId   String?
  location     Location?       @relation(fields: [locationId], references: [id])
  // Per-copy maintenance schedule (tracked items). Cycle length stays on the parent
  // Item.maintenanceCycleMonths; each copy tracks its own last/next so servicing or
  // disposing one piece doesn't move the others. Flat (non-tracked) items keep using
  // the Item-level columns instead.
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  dispenseRecords    DispenseRecord[]
  statusLogs         ItemStatusLog[]
  maintenanceRecords MaintenanceRecord[]

  @@unique([itemId, subCode])
  @@index([itemId, status])
  @@map("sub_items")
}

// --- Lots ---
model Lot {
  id           String    @id @default(cuid())
  itemId       String
  item         Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  lotNumber    String
  expiryDate   DateTime?
  receivedQty  Int       @default(0) // immutable: how much entered this lot
  remainingQty Int       @default(0) // decremented on dispense; see ADR-0002
  unitCost     Float?    // weighted-avg cost per unit (set on receive); null = unknown
  receivedDate DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  dispenseRecords DispenseRecord[]
  receiveRecords  ReceiveRecord[]
  adjustments     StockAdjustment[]

  @@unique([itemId, lotNumber])
  @@index([itemId, expiryDate])
  @@map("lots")
}

// --- Kit BOM (KIT "ภายในชุดประกอบด้วย") ---
// componentItemId = link ไป tracked Item จริง (สำหรับ assemble: ตัด stock). nullable เพื่อรองรับ
// free-text rows เดิม (name+qty+unit) ที่ import มาจาก Excel ก่อนมี feature assemble.
model KitBom {
  id              String  @id @default(cuid())
  kitItemId       String
  kitItem         Item    @relation("KitBomItems", fields: [kitItemId], references: [id], onDelete: Cascade)
  componentItemId String?
  componentItem   Item?   @relation("KitComponents", fields: [componentItemId], references: [id])
  name            String
  quantity        Int     @default(1)
  unitId          String
  unit            Unit    @relation(fields: [unitId], references: [id])
  sortOrder       Int     @default(0)

  @@index([kitItemId])
  @@index([componentItemId])
  @@map("kit_bom")
}

// --- Dispense ---
model DispenseRecord {
  id          String     @id @default(cuid())
  itemId      String
  item        Item       @relation(fields: [itemId], references: [id])
  subItemId   String?
  subItem     SubItem?   @relation(fields: [subItemId], references: [id])
  lotId       String?
  lot         Lot?       @relation(fields: [lotId], references: [id])
  quantity    Int
  resolvedQty Int        @default(0) // units no longer outstanding (returned + written off); returnedAt set when >= quantity
  usageType   UsageType?
  usageNote   String?
  staffId     String
  staff       User       @relation(fields: [staffId], references: [id])
  dispensedAt DateTime   @default(now())
  returnedAt  DateTime?
  // Condition recorded when the loan is returned; null until then (and for legacy rows).
  returnCondition ReturnCondition?
  notes       String?
  recipient   String?
  // Groups all lines of a single borrow event (1 dispense POST = 1 loanGroupId).
  // Lets the return screen show one card per loan instead of merging by item.
  loanGroupId String?
  // null (legacy) treated as BORROW. INUSE records are excluded from the รับคืน/outstanding-loan screens.
  loanType    LoanType?
  dueAt       DateTime?
  returnProofUrls String[] @default([]) // photos uploaded when the loan is returned
  recoveredAt     DateTime? // set when a return-as-LOST is reversed (เรียกคืน)

  @@index([itemId, dispensedAt])
  @@index([staffId, dispensedAt])
  @@index([usageType, dispensedAt])
  @@index([loanGroupId])
  @@map("dispense_records")
}

// --- Receive ---
model ReceiveRecord {
  id         String   @id @default(cuid())
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  lotId      String?
  lot        Lot?     @relation(fields: [lotId], references: [id])
  quantity   Int
  receivedBy String
  receiver   User     @relation(fields: [receivedBy], references: [id])
  receivedAt DateTime @default(now())
  notes      String?

  @@index([itemId, receivedAt])
  @@map("receive_records")
}

// --- Stock Adjustment ---
model StockAdjustment {
  id            String           @id @default(cuid())
  itemId        String
  item          Item             @relation(fields: [itemId], references: [id])
  lotId         String?
  lot           Lot?             @relation(fields: [lotId], references: [id])
  delta         Int              @default(0) // signed change applied to Lot.remainingQty
  previousQty   Int
  newQty        Int
  reason        AdjustmentReason
  notes         String?
  adjustedBy    String
  adjuster      User             @relation(fields: [adjustedBy], references: [id])
  imageEvidence String?
  adjustedAt    DateTime         @default(now())
  recoveredAt   DateTime? // set when a LOST adjustment is reversed (เรียกคืน)

  @@index([itemId, adjustedAt])
  @@map("stock_adjustments")
}

// --- Maintenance ---
model MaintenanceRecord {
  id                String            @id @default(cuid())
  itemId            String
  item              Item              @relation(fields: [itemId], references: [id])
  subItemId         String?
  subItem           SubItem?          @relation(fields: [subItemId], references: [id], onDelete: Cascade)
  type              MaintenanceType
  result            MaintenanceResult
  performedAt       DateTime
  performedBy       String
  performer         User              @relation(fields: [performedBy], references: [id])
  issue             String?
  description       String?
  cost              Float?
  attachmentUrls    String[]
  nextMaintenanceAt DateTime?
  repairVenue       RepairVenue?

  createdAt DateTime @default(now())

  @@index([subItemId])
  @@map("maintenance_records")
}

// --- Status Change Log ---
model ItemStatusLog {
  id             String     @id @default(cuid())
  itemId         String
  item           Item       @relation(fields: [itemId], references: [id])
  subItemId      String?
  subItem        SubItem?   @relation(fields: [subItemId], references: [id])
  previousStatus ItemStatus
  newStatus      ItemStatus
  reason         String?
  changedBy      String
  changer        User       @relation(fields: [changedBy], references: [id])
  imageUrl       String?
  repairVenue    RepairVenue?
  repairNote     String?
  changedAt      DateTime   @default(now())
  recoveredAt    DateTime? // set when a →LOST transition is reversed (เรียกคืน)

  @@map("item_status_logs")
}

// --- Location Change Log (audit trail for ย้ายที่ตั้ง) ---
// fromLabel/toLabel denormalized: an audit log is point-in-time, so the
// location name as it was at move time is what we want to show.
model LocationChangeLog {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromLabel String?
  toLabel   String?
  changedBy String
  changer   User     @relation(fields: [changedBy], references: [id])
  changedAt DateTime @default(now())

  @@index([itemId, changedAt])
  @@map("location_change_logs")
}
