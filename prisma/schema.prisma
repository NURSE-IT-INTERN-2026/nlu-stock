generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// Dispense behavior of a CategoryProfile (ประเภท). The only fixed enum.
// CONSUMABLE = ใช้แล้วทิ้ง (lot tracking, นับ remaining)
// COUNT      = ยืม-คืน นับจำนวน (track how many out)
// ITEM       = ยืม-คืน รายชิ้น (subItems, builder code)
enum DispenseType {
  CONSUMABLE
  COUNT
  ITEM
}

enum ItemStatus {
  AVAILABLE
  ON_LOAN
  IN_USE
  DAMAGED
  UNDER_REPAIR
  LOST
  DISPOSED
}

enum AdjustmentReason {
  LOST
  DAMAGED_PENDING_REPAIR
  COUNT_MISMATCH_SHORT
  COUNT_MISMATCH_OVER
  DISPOSAL
  ASSEMBLY
  // The two ways an open ชำรุด booking closes and its units come back (lib/stock
  // restoreDamagedQty). Both used to be booked as OTHER, which printed "อื่นๆ" over the row
  // that puts repaired stock back — the one row where the reason is the whole point.
  REPAIR_RETURN
  DAMAGE_CANCELLED
  OTHER
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
}

enum MaintenanceResult {
  AVAILABLE
  NEEDS_MORE_REPAIR
  DISPOSED
}

// Where a damaged piece is sent for repair (set on the DAMAGED → UNDER_REPAIR log row).
enum RepairVenue {
  INTERNAL
  EXTERNAL
}

enum ItemCondition {
  NEW
  OLD
  USABLE
  FAIR
  UNUSABLE
  DAMAGED
}

// Outcome recorded when a borrowable loan is returned. AVAILABLE = ปกติ.
enum ReturnCondition {
  AVAILABLE
  DAMAGED
  LOST
}

// How a durable was issued. BORROW = ยืม (must return by dueAt); INUSE = ตั้งใช้ในห้อง
// (open-ended, no due date, returned via คืนเข้าพัสดุ / status route, NOT the รับคืน loan screen).
enum LoanType {
  BORROW
  INUSE
  // เบิกใช้ — ของสิ้นเปลืองที่ออกไปแล้วไม่กลับ. เคยเขียนเป็น NULL ซึ่งทับความหมายกับ "แถวเก่า
  // ก่อนมีคอลัมน์นี้" จนแยกไม่ออก และบังคับให้ทุก query ต้องเขียน OR [null, BORROW] กันแถวหาย
  // (Prisma แปล `not: "INUSE"` เป็น SQL ที่ NULL-unsafe). ค่าจริงทำให้คอลัมน์เป็น NOT NULL ได้.
  CONSUME
}

enum UsageType {
  COURSE
  ACTIVITY
  OTHER
}

// --- Users ---
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  // No role column — roles come from env allowlists (src/lib/roles.ts). This row
  // exists only so every movement record has an owner to point at (8 FKs below).
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dispenseRecords    DispenseRecord[]
  receiveRecords     ReceiveRecord[]
  adjustments        StockAdjustment[]
  maintenanceRecords MaintenanceRecord[]
  statusChanges      ItemStatusLog[]
  locationChanges    LocationChangeLog[]
  dispenseTemplates  DispenseTemplate[]
  returnRecords      ReturnRecord[]
  attachmentChanges  AttachmentLog[]

  @@map("users")
}

// --- Dispense cart templates (shared, reusable withdrawal sets) ---
// Lines store only itemId + quantity — NOT lotId/subItemId. Lots get consumed/expire and
// tracked copies get borrowed, so pinning specific stock in a reusable set rots fast. The
// cart resolves lot/copy fresh at load time via buildCartItem (src/components/dispense/cart-context.tsx).
model DispenseTemplate {
  id          String                 @id @default(cuid())
  name        String
  createdById String
  createdBy   User                   @relation(fields: [createdById], references: [id])
  lines       DispenseTemplateLine[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@map("dispense_templates")
}

model DispenseTemplateLine {
  id         String           @id @default(cuid())
  templateId String
  template   DispenseTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item             @relation(fields: [itemId], references: [id])
  quantity   Int

  @@index([templateId])
  @@map("dispense_template_lines")
}

// --- Categories ---
model CategoryType {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  sortOrder   Int     @default(0)

  // ประเภท (profile) — กำหนด dispense/track behavior
  profileId String
  profile   CategoryProfile @relation(fields: [profileId], references: [id])

  items Item[]

  @@map("categories")
}

// ประเภท (CategoryProfile) — addable from UI. behavior อยู่ใน dispenseType + flags.
// icon/color/name/desc = cosmetic. code = prefix สำหรับ NLU-{code}-NNN.
model CategoryProfile {
  id            String       @id @default(cuid())
  name          String       @unique
  code          String       @unique
  description   String?
  dispenseType  DispenseType
  assetTracking Boolean      @default(false) // โชว์ fields จัดซื้อ/บำรุงรักษา (KRU/ELE)
  setTracking   Boolean      @default(false) // โชว์ setSize (BOOK/TOY)
  icon          String       @default("Package")
  color         String       @default("bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200")
  sortOrder     Int          @default(0)
  isActive      Boolean      @default(true)

  subCategories CategoryType[]

  @@map("category_profiles")
}

// --- Locations ---
model Location {
  id       String  @id @default(cuid())
  building String
  floor    String
  room     String
  detail   String?

  items           Item[]
  subItems        SubItem[]
  dispenseRecords DispenseRecord[]

  @@unique([building, floor, room, detail])
  @@map("locations")
}

// --- Units ---
model Unit {
  id   String @id @default(cuid())
  name String @unique

  items       Item[]   @relation("UnitItem")
  kitBomItems KitBom[]

  @@map("units")
}

// --- Items ---
model Item {
  id                String       @id @default(cuid())
  code              String       @unique
  name              String
  nameEn            String?
  categoryId        String
  category          CategoryType @relation(fields: [categoryId], references: [id])
  trackIndividually Boolean      @default(false)
  status            ItemStatus   @default(AVAILABLE)
  issueUnitId       String
  issueUnit         Unit         @relation("UnitItem", fields: [issueUnitId], references: [id])
  minThreshold      Int          @default(0)
  locationId        String?
  location          Location?    @relation(fields: [locationId], references: [id])
  imageUrl          String?
  images            String[]     @default([])
  description       String?
  isActive          Boolean      @default(true)

  // AI embedding (pgvector)
  embedding Unsupported("vector(768)")?
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt

  // Running total
  totalQty     Int @default(0)
  availableQty Int @default(0)

  // Consumable fields (used when category = CON)
  storageRequirements String?

  // Book/Toy set size — volumes per set; 1 = single.
  // No borrowLimit/borrowable here: both were write-only for their whole life (nothing
  // read them to allow or deny a loan) while the UI promised "0 = ห้ามยืม". What actually
  // stops a loan is the piece's status — dispense rejects any SubItem that is not
  // AVAILABLE, and ตั้งใช้ในห้อง (IN_USE) is how a piece is kept off the loan pool.
  setSize Int @default(1)

  // Stock count cycle (ตรวจนับ). countCycleMonths null = use the profile default
  // (CONSUMABLE 3 months, everything else 12) — see src/lib/stock-count.ts. Set a
  // number to override per item. nextCountDate null = never counted → due now.
  countCycleMonths Int?
  lastCountDate    DateTime?
  nextCountDate    DateTime?

  // Fixed Asset fields (nullable, used when category = KRU, ELE)
  model                  String?
  purchaseDate           DateTime?
  purchasePrice          Float?
  vendorCompany          String?
  vendorContact          String?
  vendorPhone            String?
  warrantyMonths         Int       @default(0)
  maintenanceCycleMonths Int       @default(12)
  lastMaintenanceDate    DateTime?
  nextMaintenanceDate    DateTime?
  manualUrl              String?

  // Relations
  subItems           SubItem[]
  lots               Lot[]
  kitComponents      KitBom[]               @relation("KitBomItems") // KIT "ภายในชุดประกอบด้วย" (BOM)
  componentsInKits   KitBom[]               @relation("KitComponents") // reverse: ถูกใช้เป็นส่วนประกอบในชุดอื่น
  dispenseRecords    DispenseRecord[]
  receiveRecords     ReceiveRecord[]
  adjustments        StockAdjustment[]
  maintenanceRecords MaintenanceRecord[]
  statusLogs         ItemStatusLog[]
  locationChanges    LocationChangeLog[]
  templateLines      DispenseTemplateLine[]
  returnRecords      ReturnRecord[]

  @@index([categoryId, isActive])
  @@index([locationId])
  @@index([availableQty])
  @@map("items")
}

// --- Sub-Items ---
model SubItem {
  id                  String         @id @default(cuid())
  itemId              String
  item                Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  subCode             String
  name                String?
  status              ItemStatus     @default(AVAILABLE)
  condition           ItemCondition?
  serialNumber        String?
  notes               String?
  imageUrl            String?
  images              String[]
  locationId          String?
  location            Location?      @relation(fields: [locationId], references: [id])
  // Per-copy maintenance schedule (tracked items). Cycle length stays on the parent
  // Item.maintenanceCycleMonths; each copy tracks its own last/next so servicing or
  // disposing one piece doesn't move the others. Flat (non-tracked) items keep using
  // the Item-level columns instead.
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?
  // Which assembled KIT set this piece is inside RIGHT NOW (null = not in a set).
  // Self-relation: a KIT SubItem is one physically assembled set, its contents are the
  // tracked SubItems pointing at it. Cleared when the piece leaves the set (แจ้งชำรุด, or
  // ยกเลิกชุด). History of the same lives on ItemStatusLog.kitSubItemId, which outlives this.
  inKitSubItemId      String?
  inKitSubItem        SubItem?       @relation("KitContents", fields: [inKitSubItemId], references: [id])
  kitContents         SubItem[]      @relation("KitContents")
  // KIT sets only. A set is persistent: it is borrowed, returned and borrowed again, and the
  // system never counts the consumables inside it. What it does know for certain is that the
  // set has been USED since someone last confirmed it was complete — set on เบิก, cleared by
  // the ยืนยัน button on ตรวจชุด. True = ยืมไม่ได้ and not counted in availableQty.
  // Every other kind of sub-item holds the default forever.
  needsCheck          Boolean        @default(false)
  // ใบรับเข้าที่พาชิ้นนี้เข้าคลัง — ราคาต่อชิ้นจริงอ่านจาก receiveRecord.unitCost.
  // A foreign key, not a copied price: มูลค่าตัดจำหน่าย used to be ราคาเฉลี่ยของรายการ × จำนวน,
  // so ten pieces bought across three years at three prices all wrote off at one figure.
  // Pointing at the receipt keeps ONE price on file — correcting a receipt (PATCH
  // api/receive/[id]) moves every piece it delivered, with no second copy to fall out of step.
  // null = รับเข้าก่อนมีคอลัมน์นี้ → รายงานตกกลับไปใช้ Item.purchasePrice และบอกว่าเป็นประมาณการ.
  receiveRecordId     String?
  receiveRecord       ReceiveRecord? @relation(fields: [receiveRecordId], references: [id], onDelete: SetNull)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  dispenseRecords    DispenseRecord[]
  statusLogs         ItemStatusLog[]
  maintenanceRecords MaintenanceRecord[]
  returnRecords      ReturnRecord[]

  @@unique([itemId, subCode])
  @@index([itemId, status])
  @@index([inKitSubItemId])
  @@map("sub_items")
}

// --- Lots ---
model Lot {
  id           String    @id @default(cuid())
  itemId       String
  item         Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  lotNumber    String
  expiryDate   DateTime?
  receivedQty  Int       @default(0) // immutable: how much entered this lot
  remainingQty Int       @default(0) // decremented on dispense; see ADR-0002
  unitCost     Float? // weighted-avg cost per unit (set on receive); null = unknown
  receivedDate DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  dispenseRecords DispenseRecord[]
  receiveRecords  ReceiveRecord[]
  adjustments     StockAdjustment[]

  @@unique([itemId, lotNumber])
  @@index([itemId, expiryDate])
  @@map("lots")
}

// --- Kit BOM (KIT "ภายในชุดประกอบด้วย") ---
// componentItemId = link ไป tracked Item จริง (สำหรับ assemble: ตัด stock). nullable เพื่อรองรับ
// free-text rows เดิม (name+qty+unit) ที่ import มาจาก Excel ก่อนมี feature assemble.
model KitBom {
  id              String  @id @default(cuid())
  kitItemId       String
  kitItem         Item    @relation("KitBomItems", fields: [kitItemId], references: [id], onDelete: Cascade)
  componentItemId String?
  componentItem   Item?   @relation("KitComponents", fields: [componentItemId], references: [id])
  name            String
  quantity        Int     @default(1)
  unitId          String
  unit            Unit    @relation(fields: [unitId], references: [id])
  sortOrder       Int     @default(0)

  @@index([kitItemId])
  @@index([componentItemId])
  @@map("kit_bom")
}

// --- Dispense ---
model DispenseRecord {
  id              String           @id @default(cuid())
  itemId          String
  item            Item             @relation(fields: [itemId], references: [id])
  subItemId       String?
  subItem         SubItem?         @relation(fields: [subItemId], references: [id])
  lotId           String?
  lot             Lot?             @relation(fields: [lotId], references: [id])
  // Where this specific batch/piece was placed (นำไปใช้งาน / INUSE only). Must be an
  // existing Location — the picker only offers locations already in the system.
  locationId      String?
  location        Location?        @relation(fields: [locationId], references: [id])
  quantity        Int
  resolvedQty     Int              @default(0) // units no longer outstanding (returned + written off); returnedAt set when >= quantity
  usageType       UsageType?
  // COURSE only: the CMU รหัสวิชา this was dispensed for, and the course name as it read
  // at dispense time (usageNote). Snapshotting the name keeps history readable when the
  // registrar API is down and stops a renamed/retired course from rewriting old records.
  courseCode      String?
  usageNote       String?
  staffId         String
  staff           User             @relation(fields: [staffId], references: [id])
  dispensedAt     DateTime         @default(now())
  returnedAt      DateTime?
  // Condition recorded when the loan is returned; null until then (and for legacy rows).
  returnCondition ReturnCondition?
  notes           String?
  recipient       String?
  // Groups all lines of a single borrow event (1 dispense POST = 1 loanGroupId).
  // Lets the return screen show one card per loan instead of merging by item.
  loanGroupId     String?
  // null (legacy) treated as BORROW. INUSE records are excluded from the รับคืน/outstanding-loan screens.
  loanType        LoanType
  dueAt           DateTime?
  returnProofUrls String[]         @default([]) // photos uploaded when the loan is returned
  recoveredAt     DateTime? // set when a return-as-LOST is reversed (เรียกคืน)
  returns         ReturnRecord[]

  @@index([itemId, dispensedAt])
  @@index([staffId, dispensedAt])
  @@index([usageType, dispensedAt])
  @@index([courseCode, dispensedAt])
  @@index([loanGroupId])
  @@map("dispense_records")
}

// --- Receive ---
model ReceiveRecord {
  id         String   @id @default(cuid())
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  lotId      String?
  lot        Lot?     @relation(fields: [lotId], references: [id])
  quantity   Int
  // ราคาต่อหน่วยที่จ่ายจริงในการรับเข้าครั้งนี้; null = ไม่ได้กรอก.
  // This is where a purchase price belongs: the receipt is the only event carrying a price,
  // a date and a quantity at once, and it exists for every kind of พัสดุ. Item.purchasePrice
  // holds ONE price and ONE date, so a durable bought in three batches could only ever count
  // against one year — ค่าใช้จ่ายรายปี reads this instead. Item.purchasePrice stays as the
  // per-unit figure มูลค่าคงคลัง values durable stock at, kept in step on receive.
  unitCost   Float?
  receivedBy String
  receiver   User     @relation(fields: [receivedBy], references: [id])
  receivedAt DateTime @default(now())
  notes      String?
  // ชิ้นที่ใบนี้พาเข้าคลัง (ครุภัณฑ์ที่ track รายชิ้นเท่านั้น) — ใช้ตีราคาต่อชิ้นตอนตัดจำหน่าย
  subItems   SubItem[]

  @@index([itemId, receivedAt])
  @@map("receive_records")
}

// --- Return log ---
// One row per act of returning stock, written at every path that closes a loan.
// Before this existed a return only mutated the DispenseRecord in place, so a partial
// COUNT return (คืน 3 จาก 10) left no trace at all and the only name on file was the
// borrower's — never the person who took the stock back.
model ReturnRecord {
  id               String          @id @default(cuid())
  itemId           String
  item             Item            @relation(fields: [itemId], references: [id])
  subItemId        String?
  subItem          SubItem?        @relation(fields: [subItemId], references: [id])
  dispenseRecordId String?
  dispenseRecord   DispenseRecord? @relation(fields: [dispenseRecordId], references: [id])
  quantity         Int
  condition        ReturnCondition
  notes            String?
  returnedBy       String
  returner         User            @relation(fields: [returnedBy], references: [id])
  returnedAt       DateTime        @default(now())

  // The ชำรุด/สูญหาย rows this return opened. คืนสภาพชำรุด books a repair on the spot, and until
  // these existed the resulting case had no way to say where the damage came from — you opened
  // a repair and could not tell who had the thing when it broke. One of the two at most: qty
  // stock writes an adjustment, a tracked piece writes a status log.
  openedAdjustments StockAdjustment[] @relation("OpenedByReturn")
  openedStatusLogs  ItemStatusLog[]   @relation("OpenedByReturn")

  @@index([itemId, returnedAt])
  @@index([subItemId])
  @@map("return_records")
}

// --- Stock Adjustment ---
model StockAdjustment {
  id            String           @id @default(cuid())
  itemId        String
  item          Item             @relation(fields: [itemId], references: [id])
  lotId         String?
  lot           Lot?             @relation(fields: [lotId], references: [id])
  delta         Int              @default(0) // signed change applied to Lot.remainingQty
  previousQty   Int
  newQty        Int
  reason        AdjustmentReason
  notes         String?
  adjustedBy    String
  adjuster      User             @relation(fields: [adjustedBy], references: [id])
  imageEvidenceUrls String[]      @default([])
  adjustedAt    DateTime         @default(now())
  recoveredAt   DateTime? // set when a LOST adjustment is reversed (เรียกคืน) or a repair is closed

  // ── ส่งซ่อม, for a DAMAGED_PENDING_REPAIR booking of qty stock ──
  // A tracked piece carries its trip on sub_items.status + an UNDER_REPAIR log row; qty stock
  // has neither, so the booking itself holds the trip. repairSentAt null = ชำรุด รอส่งซ่อม
  // (the /alerts worklist); set = อยู่ระหว่างซ่อม (the รับคืนจากส่งซ่อม tab). Same three-step
  // flow as a piece — ชำรุด → ส่งซ่อม → รับคืน — so neither kind skips a stage.
  repairSentAt  DateTime?
  repairVenue   RepairVenue?
  repairNote    String?
  repairJobs    MaintenanceRecord[] @relation("TimelineRow")
  // The jobs that closed THIS booking. One in practice — a trip ends once.
  closedBy      MaintenanceRecord[] @relation("RepairBooking")

  // The คืนพัสดุ that opened this row, when the damage was found on the way back in. Written by
  // api/items/[id]/return, which already creates both rows in one transaction and simply had
  // nowhere to record that they were the same event. Null on every row written before this
  // column existed, and on damage reported outside a return (the แจ้งชำรุด tile). Deliberately
  // not backfilled: the pair can only be guessed from timestamps.
  fromReturnId  String?
  fromReturn    ReturnRecord?    @relation("OpenedByReturn", fields: [fromReturnId], references: [id])

  @@index([itemId, adjustedAt])
  @@map("stock_adjustments")
}

// --- Maintenance ---
model MaintenanceRecord {
  id                String            @id @default(cuid())
  itemId            String
  item              Item              @relation(fields: [itemId], references: [id])
  subItemId         String?
  subItem           SubItem?          @relation(fields: [subItemId], references: [id], onDelete: Cascade)
  type              MaintenanceType
  result            MaintenanceResult
  performedAt       DateTime
  performedBy       String
  performer         User              @relation(fields: [performedBy], references: [id])
  issue             String?
  description       String?
  cost              Float?
  attachmentUrls    String[]          @default([])
  nextMaintenanceAt DateTime?
  repairVenue       RepairVenue?
  // The stock row this job wrote, for qty stock (a tracked piece uses subItemId instead):
  // REPAIR_RETURN when the units came back, DISPOSAL when they were written off. Both rows
  // describe one รับคืนจากซ่อม, so the item timeline prints the adjustment — which carries the
  // qty and the balance — and folds this record's cost into it rather than repeating the
  // event under two names.
  adjustmentId      String?
  adjustment        StockAdjustment?  @relation("TimelineRow", fields: [adjustmentId], references: [id])
  // Which แจ้งชำรุด booking this job closed, for qty stock. `adjustmentId` above points at the
  // row this job WROTE (the รับคืน/ตัดจำหน่าย movement); this points at the row it CLOSED, which
  // is where the trip's หลักฐาน has been accumulating since แจ้งชำรุด — the photos from ส่งซ่อม and
  // from every แก้ข้อมูล edit. Without it the finished job cannot find its own evidence and the
  // last row of a repair reads as if nothing was ever attached.
  //
  // Null on every row written before this column existed. Deliberately not backfilled: the pair
  // can only be guessed from timestamps, and a guessed link presented as หลักฐานของงานนี้ is the
  // exact failure this whole feature exists to prevent. Old trips keep their evidence on the
  // แจ้งชำรุด row, where it always was.
  repairBookingId   String?
  repairBooking     StockAdjustment?  @relation("RepairBooking", fields: [repairBookingId], references: [id])

  createdAt DateTime @default(now())

  @@index([subItemId])
  @@map("maintenance_records")
}

// --- Status Change Log ---
model ItemStatusLog {
  id             String       @id @default(cuid())
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id])
  subItemId      String?
  subItem        SubItem?     @relation(fields: [subItemId], references: [id])
  previousStatus ItemStatus
  newStatus      ItemStatus
  reason         String?
  changedBy      String
  changer        User         @relation(fields: [changedBy], references: [id])
  imageUrls      String[]     @default([])
  repairVenue    RepairVenue?
  repairNote     String?
  // How many units this row is about, when it is about a quantity rather than one piece —
  // a qty ส่งซ่อม books 47 of 147 and the item's own status does not change. Null on every
  // status transition of a whole item or a tracked piece, where the count is always 1.
  qty            Int?
  // อาการที่ชำรุด for this repair trip. Set when the piece is sent for repair and again on
  // every แก้ข้อมูลการส่งซ่อม row, so a mistyped or incomplete symptom can be corrected
  // without overwriting the original log line — the newest non-null one is the current
  // symptom, the older rows keep the history. Null on non-repair rows and legacy rows
  // (those fall back to the trip-opening row's `reason`).
  damageNote     String?
  // The KIT set SubItem this piece went into / came out of. Permanent history of
  // SubItem.inKitSubItemId, which only ever holds the current set.
  kitSubItemId   String?
  changedAt      DateTime     @default(now())
  recoveredAt    DateTime? // set when a →LOST transition is reversed (เรียกคืน)
  // The คืนพัสดุ that opened this row — see StockAdjustment.fromReturnId, same reason. This is
  // the tracked-piece half: a piece handed back ชำรุด flips status here instead of booking qty.
  fromReturnId   String?
  fromReturn     ReturnRecord? @relation("OpenedByReturn", fields: [fromReturnId], references: [id])

  @@map("item_status_logs")
}

// --- Location Change Log (audit trail for ย้ายที่ตั้ง) ---
// fromLabel/toLabel denormalized: an audit log is point-in-time, so the
// location name as it was at move time is what we want to show.
model LocationChangeLog {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromLabel String?
  toLabel   String?
  changedBy String
  changer   User     @relation(fields: [changedBy], references: [id])
  changedAt DateTime @default(now())

  @@index([itemId, changedAt])
  @@map("location_change_logs")
}

// --- Attachment Log (audit trail for แนบไฟล์ย้อนหลัง) ---
// Evidence attached at the moment a record is written leaves no row here — the record's own
// createdAt/changedBy already says who filed it and when. This table exists for the files that
// arrived afterwards, because a photo added three weeks later carries different weight from one
// taken at the scene, and for removals, because หลักฐาน that can vanish without a trace is not
// หลักฐาน. Absence of a row therefore proves nothing about legacy data — the UI badges what it
// finds and stays silent otherwise.
//
// recordType/recordId is polymorphic across the three tables that own evidence arrays
// (see ATTACH_TARGETS in src/lib/attachments.ts); no FK is possible, so a hard-deleted parent
// leaves orphan rows. Nothing joins back from here, so they are invisible rather than harmful.
// REMOVE rows keep the url on purpose: the file itself is never deleted from disk, so a wrong
// delete is undone by putting the url back.
model AttachmentLog {
  id         String   @id @default(cuid())
  recordType String
  recordId   String
  url        String
  action     String // "ADD" | "REMOVE"
  byId       String
  by         User     @relation(fields: [byId], references: [id])
  at         DateTime @default(now())

  @@index([recordType, recordId, at])
  @@map("attachment_logs")
}


// --- Case numbers ---
// เลขเคส (RC-2569-0142) ต้องนิ่ง เพราะมันคือสิ่งที่คนจดใส่กระดาษ พูดทางโทรศัพท์ และเขียนบนกล่อง
// ที่ส่งไปร้านซ่อม. เดิมเลขนี้คำนวณสดจากลำดับ — พอเพิ่มหรือแยกประเภทเคสทีนึง เลขทั้งกองก็เลื่อน
// และเลขที่ใครจดไว้เมื่อวานก็ชี้ไปคนละเคส.
//
// `seq` นับรวมทั้งปี ไม่แยกตามประเภท โดยตั้งใจ: เคสที่ย้ายประเภท (ตั้งใช้ในห้อง ที่เคยถูกนับรวมกับ
// ยืม) ต้องเก็บเลขเดิมไว้ได้ เปลี่ยนแค่ prefix — ถ้านับแยกตามประเภท การย้ายก็คือการ renumber
// ซึ่งเป็นสิ่งเดียวกับที่ตารางนี้มีไว้ป้องกัน. prefix จึงเป็นการแสดงผล ไม่ใช่ตัวระบุ.
//
// `sourceKey` ตั้งใจไม่ใส่ประเภทเคสลงไป (`disp:<id>` ไม่ใช่ `BORROW:<id>`) ด้วยเหตุผลเดียวกัน —
// แถวต้นทางหนึ่งแถวคือหนึ่งเคสเสมอ ส่วนมันจะถูกเรียกว่าประเภทอะไรเปลี่ยนได้.
// ไม่มี FK: sourceKey ชี้ข้ามห้าตาราง (ดู CASE_SOURCES ใน src/lib/case-codes.ts) แถวกำพร้าจึง
// เป็นไปได้ถ้าต้นทางถูกลบ — ไม่มีอะไร join กลับมา จึงมองไม่เห็นมากกว่าเป็นอันตราย.
model CaseCode {
  sourceKey String   @id
  be        Int // พ.ศ. ที่เคสเปิด
  seq       Int
  createdAt DateTime @default(now())

  @@unique([be, seq])
  @@map("case_codes")
}

// --- Course cache (CMU รายวิชา) ---
// Read-through mirror of two APIs owned by other faculties: the course code list from
// edu.nurse.cmu.ac.th and the course title from the registrar's bulletin. Both can go
// down or change shape without notice, so the picker reads this table and only calls
// upstream when the rows go stale — an upstream failure degrades to last-known-good
// instead of taking the dispense cart down with it.
model Course {
  code     String   @id // รหัสวิชา
  name     String? // title_long_th from the registrar; null until first resolved
  // open_status on the registrar's newest revision of this course: false = retired. Retired
  // rows are kept, not deleted — a dispense filed years ago still names its course from here
  // — but lib/courses listCourses hides them, so nobody can file a new draw against a course
  // that is no longer taught. Defaults true: a course the registrar has no bulletin for
  // (real: 578101) is still in the faculty catalogue and must stay pickable.
  open     Boolean  @default(true)
  // When the faculty catalogue last confirmed this code — written only by the catalogue
  // refresh in lib/courses, which is what the 24h TTL is actually asking about. Deliberately
  // NOT @updatedAt: any other write (resolving one course's title on demand) would bump it,
  // and since the TTL reads MAX(syncedAt) across the table, one such row is enough to make
  // the whole catalogue look fresh and defer the refresh — indefinitely, if that course is
  // picked daily. The refresh is what keeps `open` and renamed titles current, so it must
  // not be something ordinary use can hold off.
  syncedAt DateTime @default(now())

  @@map("courses")
}
