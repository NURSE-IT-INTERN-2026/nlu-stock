# Database (also used by Prisma via prisma.config.ts)
DATABASE_URL="postgresql://nlu:nlu_dev@localhost:5432/nlu_stock"

# JWT Auth
JWT_SECRET="dev-secret-change-in-prod"
NEXT_PUBLIC_APP_URL="http://localhost:3000/nlu-stock"

# Roles — comma-separated emails. Not in any list = cannot sign in.
# Changing these needs a redeploy AND a re-login (role is baked into the 24h JWT).
SUPERADMIN_EMAILS="superadmin@nlu.ac.th"
ADMIN_EMAILS="admin@nlu.ac.th"
EXECUTIVE_EMAILS="executive@nlu.ac.th"

# CMU OAuth — proves the person owns the address. The *_EMAILS allowlists above still
# decide what they may do; OAuth grants nothing on its own.
# Server-only: never prefix these NEXT_PUBLIC_, the secret must not reach the browser.
CMU_CLIENT_ID=""
CMU_CLIENT_SECRET=""
# Must match the URI registered with the provider byte for byte, /nlu-stock basePath and all.
CMU_REDIRECT_URI="http://localhost:3000/nlu-stock/api/auth/cmu/callback"
CMU_OAUTH_URL="https://login.microsoftonline.com/cf81f1df-de59-4c29-91da-a2dfd04aa751/oauth2/v2.0/authorize"
CMU_TOKEN_URL="https://login.microsoftonline.com/cf81f1df-de59-4c29-91da-a2dfd04aa751/oauth2/v2.0/token"
# Optional. Leave empty to read the email out of the id_token instead of a second call.
# api.cmu.ac.th only accepts a token minted for ITS audience — a 401 here means CMU_SCOPE
# is wrong, not that the URL is. Leave the URL empty to skip the call and read the
# id_token instead; `openid` is what makes Entra mint one, so keep it in the scope either way.
CMU_USERINFO_URL="https://api.cmu.ac.th/mis/cmuaccount/prod/v3/me/basicinfo"
CMU_SCOPE="openid profile email api://cmu/Mis.Account.Read.Me.Basicinfo"

# File upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# CMU course APIs — fills the รายวิชา picker in the dispense cart (src/lib/courses.ts).
# Server-only: never prefix these NEXT_PUBLIC_, the tokens must not reach the browser.
# Without them the picker falls back to whatever is already cached in the `courses` table.
# Course code list — https://edu.nurse.cmu.ac.th/api/Publish/CourseStructure
COURSE_STRUCTURE_TOKEN=""
# Course title — https://apiservice.reg.cmu.ac.th/bulletin/{รหัสวิชา}
REG_API_TOKEN=""
REG_API_ACCOUNT=""
REG_API_ID="00081"
